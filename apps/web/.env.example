# Forger gateways to seed the catalog with (comma separated). Locally: the gateway from `pnpm forger` or `pnpm mock`.
HUB_GATEWAYS=http://localhost:8787
# Needed to DELETE /api/forgers. Empty = removal disabled.
HUB_ADMIN_TOKEN=
# Public origin for llms.txt and the agent card. Optional: derived from the request host when unset.
# NEXT_PUBLIC_SITE_URL=https://rent-a-shell.vercel.app
# Forger registry: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN come from the Vercel Marketplace (Upstash).
# Without them the registry lives in memory (local dev and tests).
