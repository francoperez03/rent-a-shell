# Copy to apps/hub/.env.local (never committed).
PORT=8790
PUBLIC_URL=http://localhost:8790          # public hub URL
HUB_GATEWAYS=http://localhost:8787        # Forger gateways registered at startup, comma separated
HUB_ADMIN_TOKEN=                          # openssl rand -hex 24; needed to remove gateways
HUB_DATA_FILE=data/hub.json
POLL_SECONDS=30
