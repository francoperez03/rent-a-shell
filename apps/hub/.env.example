# Copiar a apps/hub/.env.local (no se commitea).
PORT=8790
PUBLIC_URL=http://localhost:8790          # URL pública del hub
HUB_GATEWAYS=http://localhost:8787        # gateways de Forgers que arrancan registrados, separados por coma
HUB_ADMIN_TOKEN=                          # openssl rand -hex 24; para dar de baja gateways
HUB_DATA_FILE=data/hub.json
POLL_SECONDS=30
