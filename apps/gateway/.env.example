# Copiar a apps/gateway/.env.local (no se commitea).

# Robot y cámara
ESP32_URL=http://localhost:8080            # mock de robot-a; en la Legion: http://<ip-del-esp32>
LIVE_URL=                                  # https://<url-legion>/live/tucu/index.m3u8 (HLS de MediaMTX)
RTSP_URL=                                  # rtsp://localhost:8554/tucu (para /frame)

# Gateway
PORT=8787
PUBLIC_URL=http://localhost:8787           # URL pública del gateway (túnel)
ALLOWED_ORIGIN=*                           # dominio del sitio en Vercel
SESSION_SECRET=                            # openssl rand -hex 32
BLOCK_MINUTES=5
BLOCK_USD=1.00
MAX_BLOCKS=6

# Rieles activos (spec 08). Dev sin chain: RAILS=fake
RAILS=solana-x402,solana-pay

# Riel Solana
SOLANA_NETWORK=devnet                      # devnet | mainnet
SOLANA_PAY_TO=                             # wallet del dueño que cobra (Phantom); solo la address
SOLANA_RPC_URL=                            # opcional, default RPC público de la red
X402_FACILITATOR_URL=                      # opcional; default x402.org (devnet) o PayAI (mainnet)
X402_API_KEY=                              # solo si el facilitator de mainnet la pide

# Escrow (programa shell_escrow): con operador, Solana Pay va al escrow y al terminar se libera 90/10 o se reembolsa
SOLANA_OPERATOR_KEY=                       # secret base58 de una wallet solo para settle/refund (no puede mandar fondos a otro lado); con SOL para fees
ESCROW_HOLD_SECONDS=21600                  # plazo antes de que el pagador pueda reclamar solo (+1 h en el programa)
OFFLINE_REFUND_SECONDS=120                 # robot caído este tiempo con sesión paga: se corta y se reembolsa

# Forger
SHELL_ID=el-tucu
SHELL_NAME=El Tucu
FORGER_NAME=
FORGER_CONTACT=                            # link de contacto que ve el cliente (opcional)
FORGER_TOKEN=                              # openssl rand -hex 24; para leer los pedidos de personalización
