# Copy to apps/gateway/.env.local (never committed).

# Robot and camera
ESP32_URL=http://localhost:8080            # robot-a mock; on the Forger machine: http://<esp32-ip>
LIVE_URL=                                  # explicit HLS URL; leave empty when HLS_UPSTREAM is set
HLS_UPSTREAM=                              # http://localhost:8888 (MediaMTX); the gateway serves it at /live/*
RTSP_URL=                                  # rtsp://localhost:8554/<SHELL_ID> (for /frame)
CAMERA=                                    # used by pnpm forger: macOS index, Windows device name, Linux /dev/videoN, or "test"

# Gateway
PORT=8787
PUBLIC_URL=http://localhost:8787           # public gateway URL (tunnel); pnpm forger sets it on its own
ALLOWED_ORIGIN=*                           # website domain (e.g. on Vercel)
SESSION_SECRET=                            # openssl rand -hex 32
BLOCK_MINUTES=5
BLOCK_USD=1.00
MAX_BLOCKS=6

# Active rails (spec 08). Dev without a chain: RAILS=fake
RAILS=solana-x402,solana-pay

# Solana rail
SOLANA_NETWORK=devnet                      # devnet | mainnet
SOLANA_PAY_TO=                             # wallet that gets paid (Phantom); the address only
SOLANA_RPC_URL=                            # optional, defaults to the network's public RPC
X402_FACILITATOR_URL=                      # optional; defaults to x402.org (devnet) or PayAI (mainnet)
X402_API_KEY=                              # only if the mainnet facilitator asks for one

# Escrow (shell_escrow program): with an operator, Solana Pay goes to escrow and is released 90/10 or refunded at the end
SOLANA_OPERATOR_KEY=                       # base58 secret of a wallet used only for settle/refund (cannot send funds anywhere else); needs SOL for fees
ESCROW_HOLD_SECONDS=21600                  # time before the payer can reclaim on their own (+1 h in the program)
OFFLINE_REFUND_SECONDS=120                 # robot down this long during a paid session: end it and refund

# Forger
SHELL_ID=el-tucu
SHELL_NAME=El Tucu
FORGER_NAME=
FORGER_CONTACT=                            # contact link customers see (optional)
FORGER_TOKEN=                              # openssl rand -hex 24; to read customization requests
HUB_URL=                                   # Rent a Shell hub; pnpm forger registers here
