{
  "name": "rent-a-shell",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && node --test scripts/forger/lib.test.mjs && bash scripts/check-isolation.sh",
    "gateway": "pnpm --filter gateway dev",
    "web": "pnpm --filter web dev",
    "buyer": "pnpm --filter buyer start",
    "check-solana": "pnpm --filter @ras/rails-solana check",
    "forger": "node scripts/forger/forger.mjs",
    "forger:doctor": "node scripts/forger/forger.mjs doctor",
    "forger:spec": "node scripts/forger/forger.mjs spec",
    "forger:esp32": "node scripts/forger/forger.mjs esp32",
    "forger:cameras": "node scripts/forger/forger.mjs cameras",
    "forger:deploy": "bash scripts/forger/deploy.sh",
    "mock": "cd \"${ROBOT_A_DIR:-$HOME/repos/job/eventos/bnb-builder-session/agentes/robot-a}\" && pnpm --filter mock start"
  },
  "devDependencies": {
    "turbo": "^2.8.3",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@8.6.12",
  "engines": {
    "node": ">=22"
  }
}
